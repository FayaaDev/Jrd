# Optional local dev proxy target for the frontend.
# Run the API server separately with `npm run server` and point Vite at it.
VITE_API_TARGET=http://127.0.0.1:5050

# API server environment
# Node can load this file directly when starting `npm run server`.
X_CMC_PRO_API_KEY=

# PDF import pipeline (required for brokerage statement OCR + extraction)
MISTRAL_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
